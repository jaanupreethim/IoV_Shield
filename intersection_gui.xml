<?xml version="1.0" encoding="UTF-8"?>
<viewsettings>
    <scheme name="clean_research_view">
        <opengl antialiase="1" dither="0"/>
        <!-- Clean Off-White Background matching user diagram -->
        <background backgroundColor="244,241,234" showGrid="0"/>
        <!-- Dark Asphalt Roads with Clear White Borders -->
        <edges laneEdgeMode="0" scaleMode="0" laneShowBorders="1" showLinkDecals="1" showRails="0" hideConnectors="0" widthExaggeration="1.00">
            <colorScheme name="uniform">
                <entry color="48,48,48" name="road"/>
            </colorScheme>
        </edges>
        <!-- Bold Rectangular Vehicles (Yellow and Red) -->
        <vehicles vehicleMode="0" vehicleQuality="2" minVehicleSize="3.0" vehicleExaggeration="2.2" showBlinker="1"/>
        <pois poiName_show="1" poiName_size="50.0" poiName_color="40,40,40"/>
    </scheme>
    <viewport zoom="160" x="195.0" y="195.0"/>
    <delay value="35"/>
</viewsettings>
